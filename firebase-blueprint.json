{
  "entities": {
    "users": {
      "title": "User Profile & Portfolio Data",
      "description": "Contains user portfolio categories, assets, monthly records, transactions, price snapshots, notes, tombstones, and settings",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "string" },
        "categories": { "type": "array" },
        "assets": { "type": "array" },
        "monthlyRecords": { "type": "array" },
        "transactions": { "type": "array" },
        "monthlyAssetPrices": { "type": "object" },
        "monthlyNotes": { "type": "object" },
        "deletedRecordMonths": { "type": "array" },
        "deletedIds": { "type": "object" },
        "settings": { "type": "object" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "Per-user portfolio state synchronized across devices"
    }
  }
}
